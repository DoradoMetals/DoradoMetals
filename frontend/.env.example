# All NEXT_PUBLIC_* values are inlined into the client bundle at build time
# (frontend/Dockerfile ARGs) - restarting a running container with a new value
# does nothing. A changed value needs a new image.

# Base URL @dorado/client sends API requests to. Empty uses a relative/
# same-origin path.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Base URL for the better-auth client.
NEXT_PUBLIC_AUTH_URL=http://localhost:5000

# This app's own origin, used as the OAuth (Google sign-in) callback URL.
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Google Maps/Places JS API key for the address autocomplete widget. Required
# - ships undefined into the Maps script if unset.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Cloudflare Turnstile site key (public half). Empty renders no widget, and
# the API's fake verifier accepts the empty token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Sentry. Empty disables error reporting (Sentry.init with no dsn is a no-op).
NEXT_PUBLIC_SENTRY_DSN=
# development | uat | production - tags every event so UAT and production
# errors do not land in the same bucket.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Build-time only - uploads source maps to Sentry. Not inlined into the
# client bundle despite the NEXT_PUBLIC_ name.
NEXT_PUBLIC_SENTRY_AUTH_TOKEN=
