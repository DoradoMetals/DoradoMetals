{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],

    // The API is still JavaScript. allowJs lets tsc see it, checkJs keeps it
    // from failing the build while it is converted file by file: rename a file
    // to .ts and it starts being checked, everything else stays as it is.
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.js", "**/*.ts"],
  "exclude": ["node_modules", "migrations", "**/*.test.js"]
}
