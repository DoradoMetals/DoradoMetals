# Node 24 runs TypeScript directly by stripping types, so there is no build
# step: server.js and any converted .ts file are executed as-is. Type CHECKING
# is a separate concern and happens in CI via tsc --noEmit.
#
# Build context is the repo root. See api/Dockerfile.
FROM node:24-bookworm-slim

RUN apt-get update && apt-get install -y \
    chromium \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libgdk-pixbuf2.0-0 \
    libnspr4 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    xdg-utils \
    --no-install-recommends \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

RUN corepack enable && corepack prepare pnpm@10.29.3 --activate

WORKDIR /repo

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY api/package.json api/

RUN pnpm install --frozen-lockfile --filter @dorado/api...

COPY api api

WORKDIR /repo/api

EXPOSE 5000
CMD ["node", "--watch", "server.js"]
