# API:
DATABASE_URL=
FRONTEND_URL=http://localhost:3000

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP Settings (For Sending Emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=support@doradometals.com
EMAIL_PASSWORD=
EMAIL_FROM="Dorado Metals Support <support@doradometals.com>"

# FedEx API
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=
FEDEX_OAUTH_URL=https://apis.fedex.com/oauth/token
FEDEX_API_URL=https://apis.fedex.com/ship/v1/shipments
FEDEX_RETURN_ADDRESS_LINE_1=
FEDEX_RETURN_ADDRESS_LINE_2=
FEDEX_RETURN_CITY=
FEDEX_RETURN_STATE=
FEDEX_RETURN_ZIP=
FEDEX_RETURN_COUNTRY=

# CRON SCHEDULES
SPOT_UPDATE_SCHEDULE=
STALE_OFFERS_UPDATE_SCHEDULE=
SPOT_API_URL=

# leads is the first feature moving to the domain-namespaced schema.
# exchange (default) | dual (write both, read new) | next
# Go through dual and stay there - it is the only reversible setting.
LEADS_SOURCE=exchange

# rates is the second feature moving to the domain-namespaced schema.
RATES_SOURCE=exchange

# reviews is the third feature moving to the domain-namespaced schema.
REVIEWS_SOURCE=exchange

# sales-tax is the fourth feature moving. Target schema is tax, not core;
# the token means "the new schema" and is kept the same across features.
SALES_TAX_SOURCE=exchange

# spots is the fifth feature moving. exchange.metals splits into
# metals.metals (identity) and spots.spots (one live quote per metal).
SPOTS_SOURCE=exchange

# media is the sixth feature moving. media.images renames checksum_sha256
# to checksum; reads alias it back so the wire shape is unchanged.
MEDIA_SOURCE=exchange

# suppliers is the seventh feature moving. A supplier is an organization of
# type REFINER plus a refiners row carrying the original supplier id.
# Read-only, so there is no dual phase.
REFINERS_SOURCE=exchange

# carriers is the eighth feature moving. A carrier is an organization of type
# CARRIER plus a shipping.carriers row carrying the original carrier id, which
# FEDEX_CARRIER_ID depends on.
CARRIERS_SOURCE=exchange
