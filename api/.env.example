# Connection parts. api/env.js builds the connection URLs from these, so the
# password and host are written once rather than five times.
#
# Two real bugs came from writing five full URLs by hand: a username that was a
# stray "w", so dev stopped authenticating, and a variable whose value began
# with a second copy of its own name, so it would not parse. Neither is possible
# when the username is written once and the URL is built.
#
# The password is URL-encoded when composed, so `@`, `/`, `:` and `#` are safe
# here - which they are not inside a hand-written connection string.
PGHOST=switchback.proxy.rlwy.net
PGPORT=35357

# One credential per ROLE, not per database - the roles are what differ.
DORADO_USER=dorado
DORADO_PASSWORD=
READONLY_USER=claude_ro
READONLY_PASSWORD=

# Database names, if they are ever renamed again. Defaults are prod/dev/test.
# PROD_DATABASE=prod
# DEV_DATABASE=dev
# TEST_DATABASE=test

# ANY OF THESE MAY BE SET EXPLICITLY AND WILL WIN OVER COMPOSITION, so Railway
# injecting DATABASE_URL, or a one-off `DATABASE_URL=... node script.mjs`,
# behaves exactly as before:
#
#   DATABASE_URL                 dorado    -> dev    the app and the test suite
#   TEST_DATABASE_URL            dorado    -> test
#   DUMP_SOURCE_DATABASE_URL     dorado    -> prod   reads only
#   BACKUP_SOURCE_DATABASE_URL   dorado    -> prod   the hourly backup
#   PROD_READONLY_DATABASE_URL   claude_ro -> prod   audits
#   REFRESH_ADMIN_DATABASE_URL   dorado    -> postgres
#
# On Railway, point BACKUP_SOURCE_DATABASE_URL at the PRIVATE endpoint: the
# public proxy works but bills egress on every byte of every dump.

# Where backup.mjs writes, and refresh-from-backup.mjs reads. On Railway this
# should be a mounted volume. These files contain everything, including the
# plaintext bank details in exchange.payouts - the directory inherits that.
BACKUP_DIR=/data/backups

FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5000/api
COLLECTING_NEXUS_TAXES=false
