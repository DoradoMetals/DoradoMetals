# Connection parts. api/src/env.ts builds the connection URLs from these, so
# the password and host are written once rather than five times.
#
# Two real bugs came from writing five full URLs by hand: a username that was a
# stray "w", so dev stopped authenticating, and a variable whose value began
# with a second copy of its own name, so it would not parse. Neither is possible
# when the username is written once and the URL is built.
#
# The password is URL-encoded when composed, so `@`, `/`, `:` and `#` are safe
# here - which they are not inside a hand-written connection string.
PGHOST=switchback.proxy.rlwy.net
PGPORT=35357

# One credential per ROLE, not per database - the roles are what differ.
DORADO_USER=dorado
DORADO_PASSWORD=
READONLY_USER=claude_ro
READONLY_PASSWORD=

# Database names, if they are ever renamed again. Defaults are prod/dev/test.
# PROD_DATABASE=prod
# DEV_DATABASE=dev
# TEST_DATABASE=test

# ANY OF THESE MAY BE SET EXPLICITLY AND WILL WIN OVER COMPOSITION, so Railway
# injecting DATABASE_URL, or a one-off `DATABASE_URL=... node script.mjs`,
# behaves exactly as before:
#
#   DATABASE_URL                 dorado    -> dev    the app and the test suite
#   TEST_DATABASE_URL            dorado    -> test
#   DUMP_SOURCE_DATABASE_URL     dorado    -> prod   reads only
#   BACKUP_SOURCE_DATABASE_URL   dorado    -> prod   the hourly backup
#   PROD_READONLY_DATABASE_URL   claude_ro -> prod   audits
#   REFRESH_ADMIN_DATABASE_URL   dorado    -> postgres
#
# On Railway, point BACKUP_SOURCE_DATABASE_URL at the PRIVATE endpoint: the
# public proxy works but bills egress on every byte of every dump.
DATABASE_URL=

# App secrets.
# PAYOUT_ENCRYPTION_KEY seals bank account/routing numbers at rest. Without it
# every payout write throws rather than store a plaintext number.
PAYOUT_ENCRYPTION_KEY=
# PAYOUT_ENCRYPTION_KEY_ID=k1
# PAYOUT_ENCRYPTION_KEY_PREVIOUS=
# PAYOUT_ENCRYPTION_KEY_PREVIOUS_ID=k1

# Signs/encrypts session cookies. Read by the better-auth library itself, not
# by api/src. Outside production a missing value silently falls back to a
# public default string - set this everywhere, not just prod.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000

# Behind Cloudflare only - trusts CF-Connecting-IP for the client IP the
# captcha and the OTP rate limits are keyed by.
TRUST_CLOUDFLARE=

# Cloudflare Turnstile. The secret half of the widget's key pair; the site key
# is the frontend's NEXT_PUBLIC_TURNSTILE_SITE_KEY. With this unset the captcha
# runs on a recording fake that accepts every token - refused outright when
# NODE_ENV=production.
TURNSTILE_SECRET_KEY=

# Third-party credentials.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PLACES_API_KEY=

# The nFusion spot-price feed. The URL is the only nFusion credential in code.
SPOT_API_URL=https://api.nfusionsolutions.biz

# FedEx. _SANDBOX_ variants are read only when FEDEX_ENV=sandbox; tracking
# calls use their own separate OAuth client.
FEDEX_ENV=production
FEDEX_API_URL=https://apis.fedex.com/ship/v1/shipments
FEDEX_SANDBOX_API_URL=
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_SANDBOX_CLIENT_ID=
FEDEX_SANDBOX_CLIENT_SECRET=
FEDEX_TRACKING_CLIENT_ID=
FEDEX_TRACKING_CLIENT_SECRET=
FEDEX_TRACKING_SANDBOX_CLIENT_ID=
FEDEX_TRACKING_SANDBOX_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=
FEDEX_SANDBOX_ACCOUNT_NUMBER=
FEDEX_TRACKING_ACCOUNT_NUMBER=
FEDEX_TRACKING_SANDBOX_ACCOUNT_NUMBER=
# The return address and contact info printed on every FedEx label - config,
# not a credential, but it lives here next to the ones that are.
FEDEX_RETURN_ADDRESS_LINE_1=
FEDEX_RETURN_ADDRESS_LINE_2=
FEDEX_RETURN_CITY=
FEDEX_RETURN_STATE=
FEDEX_RETURN_ZIP=
FEDEX_RETURN_COUNTRY=
FEDEX_DORADO_NAME=
FEDEX_DORADO_PHONE_NUMBER=

# Twilio. SMS_PROVIDER=fake (the default) skips all of these and records sends
# instead of placing them.
SMS_PROVIDER=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_FROM_NUMBER=

# Resend. Without RESEND_API_KEY a fake transport is used and nothing is
# actually sent. RESEND_FROM_DOMAIN and EMAIL_FROM are required, and checked
# against each other, only when NODE_ENV=production.
RESEND_API_KEY=
RESEND_FROM_DOMAIN=
RESEND_WEBHOOK_SECRET=
RESEND_HOST=https://api.resend.com
EMAIL_FROM="Dorado Metals Support <support@doradometals.com>"

# Moov. Without MOOV_SECRET_KEY a fake rail is used.
MOOV_HOST=https://api.moov.io
MOOV_PUBLIC_KEY=
MOOV_SECRET_KEY=
MOOV_ACCOUNT_ID=
MOOV_WALLET_PAYMENT_METHOD_ID=
MOOV_WEBHOOK_SECRET=

# Plaid. Without PLAID_SECRET a fake rail is used.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_TRUIST_ACCESS_TOKEN=

# Object storage - Railway Buckets (S3-compatible). S3_ENDPOINT is the full
# URL including scheme; host, port and TLS are parsed from it. New Railway
# buckets serve virtual-hosted-style URLs (S3_FORCE_PATH_STYLE=false); a
# bucket created before that change may need it set to true - the bucket's
# Credentials tab says which.
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=false

# URLs and routing.
FRONTEND_URL=http://localhost:3000
# The API's own public URL, handed to Twilio as the callback host for
# /api/calls/twiml, /api/calls/status and /api/sms/status. Empty uses a
# relative path, which only works when Twilio can reach the API directly.
PUBLIC_API_URL=

# Cron schedules. Each is a standard cron string; unset or invalid just skips
# the job with a warning - it does not fail boot.
# ANONYMOUS_SWEEP_SCHEDULE=0 */6 * * *
# APPOINTMENT_REMINDER_SCHEDULE=0 9 * * *
# PAYMENT_RECONCILE_SCHEDULE=*/15 * * * *

# Where backup.mjs writes, and refresh-from-backup.mjs reads. On Railway this
# should be a mounted volume. These files contain everything, including the
# plaintext bank details in exchange.payouts - the directory inherits that.
BACKUP_DIR=/data/backups

# One-time January-schema reset target (migrate:reset-january). Not read by
# the running app.
# RESET_JANUARY_URL=

# Seeded e2e admin phone. Defaults to a fake number - never put a real phone
# here on a shared box.
# SEED_ADMIN_PHONE=+15555550100

# Structured logging (shared/logging). silent in tests, info in prod, debug
# shows webhook noise.
LOG_LEVEL=info

# Standard Node environment flag. Gates the Turnstile fallback, the Resend
# domain check, the Stripe live-key test guard, and log pretty-printing.
NODE_ENV=development
