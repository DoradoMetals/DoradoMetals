{
  "name": "@dorado/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The API client - one hook per endpoint, typed only from @dorado/contracts. Ships SOURCE like @dorado/components: the frontend transpiles it and typechecks it inside its own program, so there is no dist to drift from the contracts it reads.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./orders": {
      "types": "./src/orders/index.ts",
      "default": "./src/orders/index.ts"
    },
    "./checkout": {
      "types": "./src/checkout/index.ts",
      "default": "./src/checkout/index.ts"
    },
    "./payments": {
      "types": "./src/payments/index.ts",
      "default": "./src/payments/index.ts"
    },
    "./payouts": {
      "types": "./src/payouts/index.ts",
      "default": "./src/payouts/index.ts"
    },
    "./users": {
      "types": "./src/users/index.ts",
      "default": "./src/users/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tanstack/react-query": "*",
    "react": "*"
  },
  "dependencies": {
    "@dorado/contracts": "workspace:*"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
