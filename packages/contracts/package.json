{
  "name": "@dorado/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/generate-entities.mjs",
    "build": "tsc -b tsconfig.json",
    "build:clean": "rm -rf dist .tsbuildinfo && tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "node scripts/validate-against-db.mjs",
    "verify:fresh": "node scripts/verify-fresh.mjs"
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "prettier": "3.9.6",
    "typescript": "^7.0.2"
  }
}
