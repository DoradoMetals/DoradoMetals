# Variables for docker-compose.yml. Loaded into every container via
# env_file, then a few are re-listed per service for documentation.

# Postgres
POSTGRES_USER=dorado
POSTGRES_PASSWORD=
POSTGRES_DB=dev
POSTGRES_PORT=5432

# API - database and app secrets
DATABASE_URL=
PAYOUT_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# API - third-party credentials
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PLACES_API_KEY=
SPOT_API_URL=https://api.nfusionsolutions.biz

FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_TRACKING_CLIENT_ID=
FEDEX_TRACKING_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=
FEDEX_API_URL=https://apis.fedex.com/ship/v1/shipments
FEDEX_RETURN_ADDRESS_LINE_1=
FEDEX_RETURN_ADDRESS_LINE_2=
FEDEX_RETURN_CITY=
FEDEX_RETURN_STATE=
FEDEX_RETURN_ZIP=
FEDEX_RETURN_COUNTRY=

SMS_PROVIDER=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_FROM_NUMBER=

RESEND_API_KEY=
RESEND_FROM_DOMAIN=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Dorado Metals Support <support@doradometals.com>"

MOOV_PUBLIC_KEY=
MOOV_SECRET_KEY=
MOOV_ACCOUNT_ID=
MOOV_WALLET_PAYMENT_METHOD_ID=

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_TRUIST_ACCESS_TOKEN=

# API - object storage - Railway Buckets (S3-compatible). S3_ENDPOINT is the
# full URL including scheme. New Railway buckets are virtual-hosted-style
# (S3_FORCE_PATH_STYLE=false); a bucket created before that change may need
# true - the bucket's Credentials tab says which.
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=false

# API - Twilio callback host. Distinct from the frontend's
# NEXT_PUBLIC_API_URL below - this is the API's own public URL.
PUBLIC_API_URL=

# Cloudflare Turnstile: the secret half. Unset runs the recording fake.
TURNSTILE_SECRET_KEY=
TRUST_CLOUDFLARE=

# Frontend - inlined into the client bundle at build time (frontend/Dockerfile
# ARGs); restarting the container does not pick up a new value.
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_AUTH_URL=http://localhost:5000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Cloudflare Turnstile: the site key the widget renders with. Unset renders no
# widget and loads no script, and the API's fake accepts the empty token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Sentry. Empty disables error reporting.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
